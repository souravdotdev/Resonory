meta {
  name: List Items (Library)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: none
}

headers {
  Cookie: better-auth.session_token={{sessionCookie}}
}

tests {
  test("lists the User's Library", () => {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.nextCursor).to.equal(null);
  });

  test("puts the newest Item first", () => {
    const times = res.body.items.map((card) => Date.parse(card.createdAt));
    const newestFirst = [...times].sort((a, b) => b - a);
    expect(times).to.deep.equal(newestFirst);
  });

  test("gives every card its Tags and a Thumbnail URL or null", () => {
    for (const card of res.body.items) {
      expect(card.tags).to.be.an("array");
      expect(card.thumbnailUrl === null || typeof card.thumbnailUrl === "string").to.equal(true);
    }
  });
}

docs {
  Requires `sessionCookie` (see "1. Sign In (Google)").

  The User's Library: every Item they've saved, newest first, as Item cards,
  Processing and Failed Items included. There's no pagination yet, so
  `nextCursor` is always `null`.

  Each card carries its Tags, each with its Tag source (`ai` or `user`), and
  a Thumbnail URL signed for 1 hour, or `null` when the Item has no Thumbnail
  (or Supabase Storage isn't configured). Open a `thumbnailUrl` in a browser
  to check it loads.

  Try it after "Create Item (with session)" (the new card comes first, still
  Processing) and after "1. Tag an Item" (the Tag shows up on that card).
}
