PORT=<port>
# Optional: the interface to bind to (default 0.0.0.0, every interface). Use 127.0.0.1 locally.
HOST=<host>
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
REDIS_URL=redis://<host>:<port>
BETTER_AUTH_SECRET=<at-least-32-chars, e.g. from `openssl rand -base64 32`>
BETTER_AUTH_URL=<api-public-url>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
WEB_ORIGIN=<web-app-origin>
EXTENSION_ORIGIN=<extension-origin, e.g. chrome-extension://<extension-id>>
# Optional: the parent domain web and API share in production (e.g. resonory.com). Leave unset locally.
# AUTH_COOKIE_DOMAIN=<parent-domain>
# Optional: Supabase Storage, where Thumbnails are kept. Either one unset (or empty), Item cards show no Thumbnail.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-or-secret-key>
# Optional: set behind a load balancer, so request.ip (and every per-IP rate limit) is the client's, not the proxy's.
# Comma-separated proxy addresses or CIDR ranges (e.g. the platform's private network). Leave unset when clients connect directly.
# TRUST_PROXY=<proxy-addresses-or-cidrs, e.g. 10.0.0.0/8>
