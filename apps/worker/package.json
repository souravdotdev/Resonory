{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'trap \"kill 0\" EXIT; pnpm run dev:processing & pnpm run dev:tagging & wait'",
    "dev:processing": "tsx watch --env-file=.env src/itemProcessing.ts",
    "dev:tagging": "tsx watch --env-file=.env src/itemTagging.ts",
    "build": "tsup",
    "start:processing": "node dist/itemProcessing.js",
    "start:tagging": "node dist/itemTagging.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resonory/db": "workspace:*",
    "@resonory/logger": "workspace:*",
    "@resonory/shared": "workspace:*",
    "@supabase/storage-js": "^2.119.0",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^12.0.0",
    "inversify": "^8.3.0",
    "ioredis": "^6.0.0",
    "linkedom": "^0.18.15",
    "openai": "^7.57.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resonory/eslint-config": "workspace:*",
    "@resonory/typescript-config": "workspace:*",
    "@resonory/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
