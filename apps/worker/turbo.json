{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AI_TAGGING_API_KEY",
        "AI_TAGGING_BASE_URL",
        "AI_TAGGING_MODEL",
        "ITEM_TAGGING_CONCURRENCY",
        "ITEM_TAGGING_RATE_LIMIT_MAX",
        "ITEM_TAGGING_RATE_LIMIT_WINDOW_MS",
        "ITEM_TAGGING_LOCK_DURATION_MS",
        "ITEM_PROCESSING_CONCURRENCY",
        "ITEM_PROCESSING_RATE_LIMIT_MAX",
        "ITEM_PROCESSING_RATE_LIMIT_WINDOW_MS",
        "ITEM_PROCESSING_LOCK_DURATION_MS",
        "ITEM_PROCESSING_STUCK_AFTER_MS",
        "ITEM_PROCESSING_SWEEP_INTERVAL_MS"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "build": {
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AI_TAGGING_API_KEY",
        "AI_TAGGING_BASE_URL",
        "AI_TAGGING_MODEL",
        "ITEM_TAGGING_CONCURRENCY",
        "ITEM_TAGGING_RATE_LIMIT_MAX",
        "ITEM_TAGGING_RATE_LIMIT_WINDOW_MS",
        "ITEM_TAGGING_LOCK_DURATION_MS",
        "ITEM_PROCESSING_CONCURRENCY",
        "ITEM_PROCESSING_RATE_LIMIT_MAX",
        "ITEM_PROCESSING_RATE_LIMIT_WINDOW_MS",
        "ITEM_PROCESSING_LOCK_DURATION_MS",
        "ITEM_PROCESSING_STUCK_AFTER_MS",
        "ITEM_PROCESSING_SWEEP_INTERVAL_MS"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    }
  }
}
