DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>
REDIS_URL=redis://<host>:<port>
# Optional: Supabase Storage for Thumbnails (the private `thumbnails` bucket). Without both, Items get no Thumbnails.
# The service role key bypasses row-level security: server only, never in anything public.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional: AI tagging through an OpenAI-compatible model API (Groq's free tier by default).
# Without a key, AI tagging is off and Items get no AI Tags. The base URL and model default to Groq's.
AI_TAGGING_API_KEY=<groq-api-key>
AI_TAGGING_BASE_URL=https://api.groq.com/openai/v1
AI_TAGGING_MODEL=openai/gpt-oss-20b
